{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  // Type-checks the API with its tests and config files: the editor, ESLint and `npm run typecheck`
  // use it. It never emits; tsconfig.build.json is the build.
  "compilerOptions": {
    /* Language and environment: Node 26 runs ES2025 natively (as in @tsconfig/node26) */
    "target": "es2025",
    // Listed because the default lib for a target also adds DOM types. Node 26 has Temporal built
    // in; TypeScript 6.0 declares it only in esnext.temporal, which es2025 does not include.
    "lib": ["es2025", "esnext.temporal"],
    // Nest's decorators are the legacy kind: standard decorators cannot decorate parameters.
    "experimentalDecorators": true,
    // Nest's dependency injection reads constructor parameter types from this metadata.
    "emitDecoratorMetadata": true,

    /* Modules: a CommonJS app (package.json "type"); Nest 12's ES modules load through require(esm) */
    "module": "nodenext",
    // TypeScript 6.0 loads no @types packages unless listed.
    "types": ["node"],
    // ts-jest supports module nodenext only when it compiles one file at a time; tsc then rejects
    // code that single-file compilation would get wrong. `npm run typecheck` covers test types.
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "*.ts"]
}
