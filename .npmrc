# Pin exact versions, so every upgrade is an explicit, reviewable change.
# https://docs.renovatebot.com/dependency-pinning/#so-whats-best
save-exact=true
# Dependency install scripts are the usual npm malware vector, and nothing here needs them.
# Side effect: run `npm run prepare` once after cloning to install the git hooks.
ignore-scripts=true
# Refuse to install on a Node version outside package.json "engines" instead of only warning.
engine-strict=true
