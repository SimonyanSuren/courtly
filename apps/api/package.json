{
  "name": "@courtly/api",
  "version": "0.0.0",
  "description": "Courtly REST API: courts, availability and bookings.",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": "^26.13.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "NODE_ENV=production nest start --env-file .env",
    "start:dev": "NODE_ENV=production nest start --watch --env-file .env",
    "start:debug": "NODE_ENV=production nest start --debug --watch --env-file .env",
    "start:prod": "NODE_ENV=production node --enable-source-maps dist/main.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "NODE_ENV=production node --enable-source-maps --env-file-if-exists=.env dist/migrate.js",
    "db:seed": "NODE_ENV=production node --enable-source-maps --env-file-if-exists=.env dist/seed.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "NODE_ENV=production NODE_OPTIONS='--experimental-vm-modules --disable-warning=ExperimentalWarning' jest",
    "perf": "NODE_ENV=production NODE_OPTIONS='--experimental-vm-modules --disable-warning=ExperimentalWarning' jest --config jest.perf.config.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/swagger": "12.1.0",
    "@nestjs/throttler": "6.7.1",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@nestjs/cli": "12.0.11",
    "@nestjs/schematics": "12.0.12",
    "@nestjs/testing": "12.3.2",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "jest": "30.5.2",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15"
  }
}
