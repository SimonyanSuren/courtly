# Every variable the API reads. For local development, copy this file to .env and adjust it.

# Port the API listens on. Default: 3000.
PORT=3000
# Reverse proxies in front of the API whose X-Forwarded-For is trusted. Default: 0, none.
# TRUST_PROXY_HOPS=0

# PostgreSQL connection URL. This one matches the `postgres` service in compose.yaml.
DATABASE_URL=postgres://courtly:courtly@localhost:5432/courtly
# Connection pool. Defaults: 10 connections, 5000 ms to get one, 10000 ms per statement.
# DATABASE_POOL_MAX=10
# DATABASE_CONNECTION_TIMEOUT_MS=5000
# DATABASE_STATEMENT_TIMEOUT_MS=10000

# Sessions. Defaults: 7 days, cookie sent over HTTPS only. Over plain HTTP, set the second to false.
# SESSION_TTL_DAYS=7
SESSION_COOKIE_SECURE=false

# Login attempts per 15 minutes. Defaults: 50 from one client address, 10 for one email.
# LOGIN_ATTEMPTS_PER_IP=50
# LOGIN_ATTEMPTS_PER_EMAIL=10
