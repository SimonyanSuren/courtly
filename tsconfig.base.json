{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Type-checking rules shared by every workspace. Each workspace adds its own target, module
  // system and environment (Node for the API, the browser for the web app).
  "compilerOptions": {
    /* Type checking: strict plus the extra checks of @tsconfig/strictest, except
       noPropertyAccessFromIndexSignature: with noUncheckedIndexedAccess it only adds a syntax rule. */
    // On by default since TypeScript 6.0. Kept explicit so tools on an older TypeScript, such as
    // an editor's bundled version, check the same way.
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUnusedLabels": false,
    "allowUnreachableCode": false,

    /* Speed and readable errors */
    // Dependencies' .d.ts files are not type-checked: faster, and their errors are not ours to fix.
    "skipLibCheck": true,
    // Error messages show full types instead of cutting them off.
    "noErrorTruncation": true
  }
}
